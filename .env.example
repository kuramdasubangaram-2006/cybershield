# Copy this file to .env for local settings. Never commit .env.
FLASK_DEBUG=1
# Optional locally: the app creates an ignored instance/secret_key file if blank.
SECRET_KEY=
SESSION_COOKIE_SECURE=0
# Leave blank for local SQLite. Set this privately to use Supabase PostgreSQL.
DATABASE_URL=
# Brevo HTTPS API sender for Forgot password. Keep the API key private.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
# Google OAuth credentials (create a Web application OAuth client in Google Cloud).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional. Set this exact URL in Google Cloud's authorized redirect URIs.
GOOGLE_REDIRECT_URI=https://cybershield-kb.onrender.com/auth/google/callback
