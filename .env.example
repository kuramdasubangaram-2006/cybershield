# Copy this file to .env for local settings. Never commit .env.
FLASK_DEBUG=1
# Optional locally: the app creates an ignored instance/secret_key file if blank.
SECRET_KEY=
SESSION_COOKIE_SECURE=0
# Leave blank for local SQLite. Set this privately to use Supabase PostgreSQL.
DATABASE_URL=
# Optional SMTP sender for Forgot password. Keep credentials private.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
